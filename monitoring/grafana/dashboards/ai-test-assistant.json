{
  "uid": "ai-test-assistant",
  "title": "AI Test Assistant",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Jobs by outcome (per minute)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(jobs_processed_total[5m]) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Job duration p50 / p95 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(job_duration_seconds_bucket[15m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(job_duration_seconds_bucket[15m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM cache hit ratio",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "llm_cache_hits_total / clamp_min(llm_cache_hits_total + llm_cache_misses_total, 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Generated tests passed ratio",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "generated_test_files_total{result=\"passed\"} / clamp_min(sum(generated_test_files_total), 1)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM tokens (per minute)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(llm_prompt_tokens_total[5m]) * 60", "legendFormat": "prompt" },
        { "expr": "rate(llm_response_tokens_total[5m]) * 60", "legendFormat": "response" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM calls and time spent",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(llm_calls_total[5m]) * 60", "legendFormat": "calls/min" },
        { "expr": "rate(llm_seconds_total[5m]) * 60", "legendFormat": "llm seconds/min" }
      ]
    }
  ]
}
